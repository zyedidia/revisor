# Revisor minimal guest kernel config fragment.
# Apply on top of allnoconfig:
#   make ARCH=x86_64 allnoconfig
#   scripts/kconfig/merge_config.sh -m .config /path/to/kernel.config
#   make ARCH=x86_64 olddefconfig

# Match gokvm's kernel (SMP required for proper interrupt delivery)
CONFIG_SMP=y

# Console output
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EARLY_PRINTK=y

# initramfs
CONFIG_BLK_DEV_INITRD=y

# Filesystems needed by init
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y

# Execute ELF binaries
CONFIG_BINFMT_ELF=y

# Fast decompression
CONFIG_KERNEL_LZ4=y

# KVM guest support
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y

# /dev/mem access (debugging)
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# Unix sockets (for IPC proxy socketpair)
CONFIG_NET=y
CONFIG_UNIX=y

# Revisor arena driver
CONFIG_REVISOR_ARENA=y
